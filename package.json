{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "icons": "node scripts/generate-icons.mjs",
        "test:browser": "playwright test",
        "check:contrast": "node scripts/check-contrast.mjs",
        "check:a11y": "node scripts/check-accessibility.mjs",
        "measure:performance": "node scripts/measure-performance.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
        "@fontsource/plus-jakarta-sans": "^5.3.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
