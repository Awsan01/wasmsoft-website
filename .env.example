# Wasmsoft website — environment configuration.
# Copy to .env for local development (composer run setup does this).
# Production values are described in docs/deployment.md. Never commit a real
# .env file: it holds the application key and passwords.

APP_NAME=Wasmsoft
# local | testing | production
APP_ENV=local
# Generated by `php artisan key:generate`. Keep the production key in your
# secrets store: without it, sessions and encrypted values cannot be read.
APP_KEY=
# Must be false in production (errors would otherwise show code and settings).
APP_DEBUG=true
# The public address, with https:// in production.
APP_URL=http://localhost:8000

# Default language until an administrator chooses one in Settings (ar, en or tr).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: daily (rotated files, see LOG_DAILY_DAYS) or your log service.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error.
LOG_LEVEL=debug

# Development and tests use SQLite (database/database.sqlite).
# Production: mysql, mariadb or pgsql — see docs/deployment.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=wasmsoft
# DB_USERNAME=wasmsoft
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are HTTPS-only by default when APP_ENV=production; set false only
# if production is (wrongly) served over plain HTTP.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Password reset and invitation emails and new-inquiry alerts are queued:
# production needs a queue worker (docs/deployment.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development writes emails to the log. Production: smtp (or another
# mailer) with the credentials of your mail provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed when MEDIA_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-side rendering of the public site: pages arrive with their content
# already in the HTML instead of being drawn by the browser. Needs Node.js on
# the server and `php artisan inertia:start-ssr` running as a service (see
# docs/deployment.md). When off, or when that service is down, pages are
# drawn in the browser; their <head> metadata is in the HTML either way.
INERTIA_SSR_ENABLED=false

# Load balancers or CDNs in front of the application: their IP addresses or
# CIDR ranges (comma-separated), or * when the application can only be
# reached through the proxy. Needed for HTTPS detection and for the real
# visitor IP in rate limits and the audit log. Leave unset otherwise.
# TRUSTED_PROXIES=10.0.0.0/8

# ---------------------------------------------------------------------------
# Wasmsoft settings (config/wasmsoft.php). The defaults shown are used when a
# variable is not set. Company details, languages and links are managed in
# the dashboard (Settings), not here.
# ---------------------------------------------------------------------------

# Time zone for dates shown and typed in the dashboard, e.g. Europe/Istanbul.
# Dates are always stored in UTC.
DISPLAY_TIMEZONE=UTC

# Storage disk for uploaded media: public (storage/app/public, served through
# `php artisan storage:link`) or s3.
MEDIA_DISK=public
MEDIA_MAX_IMAGE_KB=8192
MEDIA_MAX_DOCUMENT_KB=15360

# Contact form: messages accepted per visitor (IP address) per hour.
CONTACT_MAX_PER_HOUR=5
# Days before inquiries (personal data) are deleted automatically.
INQUIRY_RETENTION_DAYS=730
# Days before audit log entries are deleted automatically.
AUDIT_RETENTION_DAYS=365

# Minutes an invitation link stays valid (default three days).
INVITATION_EXPIRE_MINUTES=4320

# Seconds public content stays cached (changes clear the cache immediately).
CONTENT_CACHE_TTL=3600
# Seconds a shared cache or CDN may keep a public page (Cache-Control
# s-maxage). 0 disables shared caching.
HTTP_CACHE_SECONDS=300

# Local development only: password of the demo accounts created by
# `php artisan migrate --seed` (refused outside local environments).
DEV_SEED_PASSWORD=Wasmsoft-Dev-2026

# Laravel Boost (dev tooling). Its browser logger injects an inline script,
# which the strict Content-Security-Policy blocks by design.
BOOST_BROWSER_LOGS_WATCHER=false
